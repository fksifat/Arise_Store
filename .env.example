# Local defaults; scripts/setup-local.sh generates random secrets in .env.
APP_ENV=development
APP_DEBUG=false
SECRET_KEY=GENERATE_WITH_SETUP_SCRIPT
COOKIE_SECURE=false
SEED_DEMO_DATA=false
AUTO_CREATE_TABLES=false
DATABASE_URL=sqlite:///./.data/arise.db
REDIS_URL=
PLATFORM_BASE_DOMAIN=arisestore.com
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1","api","testserver"]
DOMAIN_ROUTING_ENABLED=false
API_INTERNAL_URL=http://127.0.0.1:8000
POSTGRES_USER=arise
POSTGRES_PASSWORD=GENERATE_WITH_SETUP_SCRIPT
POSTGRES_DB=arise
